run = "nim --version"
modules = ["python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "nim c --threads:off -d:ssl main.nim && PORT=5000 ./main"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
CEREBRAS_GEMMA4_MODEL = "qwen-3.8-27b"

[deployment]
deploymentTarget = "vm"
run = ["./main"]
build = ["nim", "c", "--threads:off", "-d:ssl", "-d:release", "main.nim"]
